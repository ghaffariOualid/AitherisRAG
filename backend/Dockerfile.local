# Local-stack image. Kept separate from Dockerfile so local compatibility
# changes do not alter the project's production image.
FROM python:3.12-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    libxcb1 \
    libx11-xcb1 \
    libxrender1 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PYTHONPATH=/app \
    HF_HOME=/home/ragio/.cache/huggingface \
    HF_HUB_CACHE=/home/ragio/.cache/huggingface/hub

COPY requirements.txt ./

# Loading PyTorch-format BGE weights requires PyTorch 2.6 or newer. Use the CPU wheel so
# the complete stack runs on ordinary Docker Desktop/Linux installations.
RUN pip install --no-cache-dir torch==2.6.0+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt \
    && python -m spacy download en_core_web_sm

COPY celery_app.py ./
COPY app/ ./app/
COPY alembic.ini ./
COPY migrations/ ./migrations/
COPY scripts/ ./scripts/
COPY tests/ ./tests/

RUN useradd -r -m -u 1000 -d /home/ragio ragio \
    && mkdir -p /home/ragio/.cache/huggingface \
    && chown -R ragio:ragio /app /home/ragio \
    && chmod -R 777 /home/ragio

# Models are prepared by model_init in a persistent shared Docker volume.
# Download failures stop that service before the API healthcheck starts.

FROM base AS backend-image

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers ${UVICORN_WORKERS:-1} --log-level info --access-log"]

FROM base AS flower-image

CMD ["celery", "flower"]
