# Local Docker configuration for RAG.
# ./ragio start creates .env.local from this file on first use.

# Ports exposed on your computer. Change a port if it is already occupied.
HTTP_PORT=3003
API_PORT=8088
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
FLOWER_PORT=5555

# Local-only service credentials. Change these before exposing the stack.
POSTGRES_DB=hcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ragio-local-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Required by the API. These development values are deliberately only for a
# localhost Docker stack; do not reuse them in a deployed environment.
SECRET_KEY=ragio-local-access-secret-change-before-production
REFRESH_SECRET_KEY=ragio-local-refresh-secret-change-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:3003
MINIO_BUCKET_NAME=documents

# RAG model settings. The repository includes its model cache for offline use.
MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
LLM_TEMPERATURE=0.3

# Set this to a Mistral API key to enable AI answers. All local infrastructure,
# uploads, indexing, auth, and the UI run without it, but chat responses need
# an LLM provider.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FALLBACK_MODELS=

# Optional cross-provider fallbacks. Add one key to use it when Mistral is unavailable.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite

MAX_FILE_SIZE_MB=200
MAX_FILES_PER_USER=20
MAX_CHATS_PER_HOUR=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CELERY_CONCURRENCY=1
